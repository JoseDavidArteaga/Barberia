	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script que se ejecuta antes de cada request",
					"console.log(\"🚀 Ejecutando request a: \" + pm.request.url);",
					"",
					"// Verificar que baseUrl esté configurada",
					"if (!pm.environment.get(\"baseUrl\")) {",
					"    pm.environment.set(\"baseUrl\", \"http://localhost:5000\");",
					"    console.log(\"⚙️  BaseUrl configurada automáticamente a: http://localhost:5000\");",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script que se ejecuta después de cada request",
					"console.log(\"✅ Request completado con status: \" + pm.response.code);",
					"",
					"// Log de tiempo de respuesta",
					"pm.test(\"Response time is reasonable\", function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(3000);",
					"});",
					"",
					"// Log del tipo de contenido para requests exitosos",
					"if (pm.response.code < 400) {",
					"    pm.test(\"Content-Type is JSON for successful requests\", function () {",
					"        pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
					"    });",
					"}"
				]
			}
		}
