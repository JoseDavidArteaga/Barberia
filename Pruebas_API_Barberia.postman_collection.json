{
	"info": {
		"_postman_id": "barberia-vintage-api",
		"name": "API Barbería Vintage - Pruebas CRUD",
		"description": "Colección de pruebas para la API REST de la Barbería Vintage. Incluye todas las operaciones CRUD para gestión de productos/servicios.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
